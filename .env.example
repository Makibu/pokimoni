# Copy to .env.local and fill in. Never commit real values.

# Legacy Supabase REST access (removed after phase 3 of AUDIT/REFACTORING_PLAN.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign session tokens (at least 32 random characters)
JWT_SECRET=

# Postgres connection for the app (Supabase pooler, transaction mode, port 6543)
# Supabase dashboard -> Connect -> Transaction pooler
DATABASE_URL=
